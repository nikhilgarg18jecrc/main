{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ADF-Learning-0009"
		},
		"AzureSqlDatabase1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabase1'"
		},
		"AzureSqlDatabase1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ngdevserver.database.windows.net"
		},
		"AzureSqlDatabase1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "ng_db_dev"
		},
		"AzureSqlDatabase1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "nikhilgarg"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/AzureSqlDatabase1')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"parameters": {
					"DB_NM": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('AzureSqlDatabase1_properties_typeProperties_server')]",
					"database": "[parameters('AzureSqlDatabase1_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('AzureSqlDatabase1_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('AzureSqlDatabase1_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/AzureSqlTable1')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "AzureSqlDatabase1",
					"type": "LinkedServiceReference",
					"parameters": {
						"DB_NM": "ng_db_dev"
					}
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [
					{
						"name": "PRIMARY_KEY",
						"type": "varchar"
					},
					{
						"name": "EVENT_DT",
						"type": "date"
					},
					{
						"name": "FULL_NAME",
						"type": "varchar"
					},
					{
						"name": "EMAIL",
						"type": "varchar"
					},
					{
						"name": "EMAIL_STATUS",
						"type": "varchar"
					},
					{
						"name": "ADDRESS",
						"type": "varchar"
					},
					{
						"name": "CITY",
						"type": "varchar"
					},
					{
						"name": "STATE",
						"type": "varchar"
					},
					{
						"name": "ZIPCODE",
						"type": "varchar"
					},
					{
						"name": "PHONE",
						"type": "int",
						"precision": 10
					},
					{
						"name": "CREATED_DT",
						"type": "datetime",
						"precision": 23,
						"scale": 3
					},
					{
						"name": "CREATED_BY",
						"type": "varchar"
					},
					{
						"name": "LAST_MODIFIED_DT",
						"type": "datetime",
						"precision": 23,
						"scale": 3
					},
					{
						"name": "LAST_MODIFIED_BY",
						"type": "varchar"
					}
				],
				"typeProperties": {
					"schema": "SalesLT",
					"table": "DWH_PATIENT_DATA"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/AzureSqlDatabase1')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/SRC_PSA_TBL')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "AzureSqlDatabase1",
					"type": "LinkedServiceReference",
					"parameters": {
						"DB_NM": "ng_db_dev"
					}
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [
					{
						"name": "PRIMARY_KEY",
						"type": "varchar"
					},
					{
						"name": "SERIAL_KEY",
						"type": "int",
						"precision": 10
					},
					{
						"name": "BRAND_CD",
						"type": "varchar"
					},
					{
						"name": "OPT_LEVEL",
						"type": "varchar"
					},
					{
						"name": "EVENT_DT",
						"type": "date"
					},
					{
						"name": "FIRST_NAME",
						"type": "varchar"
					},
					{
						"name": "LAST_NAME",
						"type": "varchar"
					},
					{
						"name": "FULL_NAME",
						"type": "varchar"
					},
					{
						"name": "EMAIL",
						"type": "varchar"
					},
					{
						"name": "ADDRESS",
						"type": "varchar"
					},
					{
						"name": "CITY",
						"type": "varchar"
					},
					{
						"name": "STATE",
						"type": "varchar"
					},
					{
						"name": "ZIPCODE",
						"type": "varchar"
					},
					{
						"name": "PHONE",
						"type": "int",
						"precision": 10
					},
					{
						"name": "CREATED_DT",
						"type": "datetime",
						"precision": 23,
						"scale": 3
					},
					{
						"name": "CREATED_BY",
						"type": "varchar"
					},
					{
						"name": "LAST_MODIFIED_DT",
						"type": "datetime",
						"precision": 23,
						"scale": 3
					},
					{
						"name": "LAST_MODIFIED_BY",
						"type": "varchar"
					}
				],
				"typeProperties": {
					"schema": "SalesLT",
					"table": "PSA_PATIENT_DATA"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/AzureSqlDatabase1')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DWH_LOAD_PARAMETRIZE')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "SRC_PSA_TBL",
								"type": "DatasetReference"
							},
							"name": "PSATable"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "AzureSqlTable1",
								"type": "DatasetReference"
							},
							"name": "DWH"
						}
					],
					"transformations": [],
					"scriptLines": [
						"source(output(",
						"          PRIMARY_KEY as string,",
						"          SERIAL_KEY as integer,",
						"          BRAND_CD as string,",
						"          OPT_LEVEL as string,",
						"          EVENT_DT as date,",
						"          FIRST_NAME as string,",
						"          LAST_NAME as string,",
						"          FULL_NAME as string,",
						"          EMAIL as string,",
						"          ADDRESS as string,",
						"          CITY as string,",
						"          STATE as string,",
						"          ZIPCODE as string,",
						"          PHONE as integer,",
						"          CREATED_DT as timestamp,",
						"          CREATED_BY as string,",
						"          LAST_MODIFIED_DT as timestamp,",
						"          LAST_MODIFIED_BY as string",
						"     ),",
						"     allowSchemaDrift: false,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT DISTINCT PRIMARY_KEY,SERIAL_KEY,BRAND_CD,OPT_LEVEL,EVENT_DT FROM SalesLT.PSA_PATIENT_DATA where EVENT_DT<\\'2025-04-01\\';',",
						"     format: 'query') ~> PSATable",
						"PSATable sink(allowSchemaDrift: false,",
						"     validateSchema: false,",
						"     input(",
						"          PRIMARY_KEY as string,",
						"          EVENT_DT as date,",
						"          FULL_NAME as string,",
						"          EMAIL as string,",
						"          EMAIL_STATUS as string,",
						"          ADDRESS as string,",
						"          CITY as string,",
						"          STATE as string,",
						"          ZIPCODE as string,",
						"          PHONE as integer,",
						"          CREATED_DT as timestamp,",
						"          CREATED_BY as string,",
						"          LAST_MODIFIED_DT as timestamp,",
						"          LAST_MODIFIED_BY as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     truncate:true,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          PRIMARY_KEY,",
						"          EVENT_DT,",
						"          FULL_NAME,",
						"          EMAIL,",
						"          ADDRESS,",
						"          CITY,",
						"          STATE,",
						"          ZIPCODE,",
						"          PHONE,",
						"          CREATED_DT,",
						"          CREATED_BY,",
						"          LAST_MODIFIED_DT,",
						"          LAST_MODIFIED_BY",
						"     )) ~> DWH"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/SRC_PSA_TBL')]",
				"[concat(variables('factoryId'), '/datasets/AzureSqlTable1')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/SRC Query Read Test')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "SRC_QUERY_READ",
						"type": "ExecuteDataFlow",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataflow": {
								"referenceName": "DWH_LOAD_PARAMETRIZE",
								"type": "DataFlowReference",
								"parameters": {},
								"datasetParameters": {
									"PSATable": {},
									"DWH": {}
								}
							},
							"staging": {},
							"compute": {
								"coreCount": 8,
								"computeType": "General"
							},
							"traceLevel": "Coarse"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/dataflows/DWH_LOAD_PARAMETRIZE')]"
			]
		}
	]
}