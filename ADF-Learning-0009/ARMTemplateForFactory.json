					"scriptLines": [
						"parameters{",
						"     EVENT_DT_FIL as string",
						"}",
						"source(output(",
						"          PRIMARY_KEY as string,",
						"          SERIAL_KEY as integer,",
						"          BRAND_CD as string,",
